# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Settings > Environment Variables).
# NUNCA commite valores reais.

# Supabase > Project Settings > API Keys (ou botão "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave
# Projetos antigos sem chave publishable: use a chave "anon public" no lugar
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# URL pública do app (usada nos links de convite/recuperação de senha)
NEXT_PUBLIC_SITE_URL=https://seu-app.vercel.app

# SOMENTE SERVIDOR — sem NEXT_PUBLIC_. Usada apenas na área /admin.
# Supabase > Project Settings > API Keys > "secret" (service_role)
SUPABASE_SERVICE_ROLE_KEY=
